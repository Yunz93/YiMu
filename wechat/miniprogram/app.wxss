page{background:#f7f8f5;color:#29362e;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx;line-height:1.7}view,text,button,scroll-view{box-sizing:border-box}button{margin:0;border-radius:14rpx;font-size:26rpx;line-height:1.5;padding:18rpx 22rpx;background:#eef3e9;color:#426650}button::after{border:none}button[disabled]{opacity:.4}button.primary{background:#426650;color:#fff}button.plain{background:#fff;border:1rpx solid #dfe7d7}button.danger{color:#a16f4e;background:#fbf2e8}.page{padding:30rpx 28rpx 48rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:#8fa07c}.title{font-size:43rpx;font-weight:650;line-height:1.4;margin:10rpx 0}.subtitle,.muted{font-size:24rpx;color:#89957f}.card{background:#fff;border:1rpx solid #e3e9dd;border-radius:22rpx;padding:28rpx;margin-top:24rpx}.section-title{font-size:30rpx;font-weight:600;margin-bottom:14rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{display:flex;flex-wrap:wrap;gap:12rpx}.tag{font-size:21rpx;padding:5rpx 12rpx;border-radius:8rpx;background:#eef3e7;color:#718958}.divider{height:1rpx;background:#e8ede3;margin:24rpx 0}.note{font-size:23rpx;color:#8b977f;line-height:1.9;margin-top:18rpx}.actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.actions button{flex:1;min-width:140rpx}.chips{display:flex;flex-wrap:wrap;gap:10rpx;margin:24rpx 0}.chip{font-size:23rpx;padding:12rpx 18rpx;border-radius:10rpx;background:#edf2e7;color:#839575}.chip.selected{background:#426650;color:#fff}.mask{position:fixed;inset:0;background:rgba(28,47,31,.45);z-index:200;display:flex;align-items:flex-end}.sheet{display:flex;flex-direction:column;width:100%;max-height:86vh;background:#fcfdf9;border-radius:28rpx 28rpx 0 0;padding:28rpx 30rpx;padding-bottom:calc(28rpx + env(safe-area-inset-bottom))}.sheet-body{height:60vh;min-height:0;flex:1}.sheet>.row,.sheet>button{flex-shrink:0}.sheet-title{font-size:34rpx;font-weight:600;flex:1}.close{padding:10rpx 18rpx;background:transparent;font-size:30rpx}.paragraph{font-size:26rpx;color:#738668;line-height:1.95;margin:16rpx 0}.callout{padding:20rpx;border-radius:12rpx;background:#edf3e5;margin:18rpx 0;font-size:26rpx}.risk{background:#fbf2e8;color:#976d4c}.setting{padding:22rpx 0;border-bottom:1rpx solid #e6ecdf}.picker{padding:12rpx 18rpx;border:1rpx solid #dce5d3;border-radius:10rpx;color:#526f42}.link{color:#426650;font-size:25rpx}.stats{display:flex;gap:14rpx;margin:24rpx 0}.stat{flex:1;min-width:0;text-align:center;background:#edf3e6;border-radius:14rpx;padding:24rpx 8rpx}.stat-value{font-size:43rpx;font-weight:600;color:#547343;font-variant-numeric:tabular-nums}.stat-label{font-size:22rpx;color:#91a080}.progress{height:10rpx;background:#e5ecde;border-radius:10rpx;overflow:hidden}.progress-fill{height:100%;background:#799d65}.empty{text-align:center;padding:38rpx 20rpx;border:1rpx dashed #dbe4d2;border-radius:16rpx}.success{color:#65864b}
