<view class="page game {{globalMode ? 'global' : ''}}">
 <view class="row game-header"><view><view class="eyebrow" wx:if="{{!globalMode}}">YIMU GO · 一目</view><view class="title">{{globalMode ? '专注棋盘' : '每一手，都看得懂。'}}</view></view><button class="plain compact" bindtap="toggleGlobal">{{globalMode ? '退出全局' : '全局模式'}}</button></view>
 <view class="score-row"><view class="score-side"><text class="stone-dot black"></text>黑 <text class="score-value">{{score.black}}</text></view><view class="score-center"><text>{{score.label}}</text><text>{{turnLabel}}</text></view><view class="score-side"><text class="stone-dot white"></text>白 <text class="score-value">{{score.white}}</text></view></view>
 <view class="row board-meta"><text>{{n}} 路{{n === 19 ? '标准' : ''}} · 你执{{humanLabel}}</text><text>{{saved ? '进度保存在本机' : '本次进度暂未保存'}}</text></view>
 <view class="board-area"><go-board id="game-board" size="{{boardSize}}" n="{{n}}" board="{{board}}" last="{{last}}" preview-at="{{previewAt}}" hint-at="{{hintAt}}" captured="{{captured}}" liberties="{{liberties}}" group-stones="{{groupStones}}" influence="{{inf}}" owners="{{owners}}" dead="{{dead}}" preview-enabled="{{canPreview}}" disabled="{{busy || scored}}" bind:pick="pick" bind:preview="preview" bind:clearpreview="clearPreview" /></view>
 <view class="row view-row"><view class="view-tabs"><button wx:for="{{views}}" wx:key="id" data-view="{{item.id}}" bindtap="changeView" class="view-tab {{view === item.id ? 'active' : ''}}">{{item.label}}</button></view><view class="preview-control"><text>预览</text><switch checked="{{previewEnabled}}" disabled="{{busy || ended}}" bindchange="togglePreview" color="#67875a" /></view></view>
 <view class="actions game-actions"><button bindtap="undo" disabled="{{!moves || scored}}">悔一手</button><button bindtap="hint" disabled="{{busy || ended}}">给我提示</button><button bindtap="pass" disabled="{{busy || scored}}">{{ended ? '继续对弈' : '停一手'}}</button><button bindtap="finish" disabled="{{busy}}">{{scored ? '新一局' : ended ? '确认结果' : '结束数子'}}</button></view>
 <view class="ai-error" wx:if="{{aiError}}"><text>{{aiError}}</text><button bindtap="retryAI">重试 AI</button></view>
 <view class="normal-content" wx:if="{{!globalMode}}"><view class="row note"><text>轻点落子 · 长按约 0.4 秒预览</text><text>松手不落子</text></view><view class="note">{{score.verdict}} · {{score.neutral}} 点{{ended ? '中立' : '未定'}}。白方含 7.5 点贴目，局中为估算。</view>
 <view class="card coach"><view class="row"><text class="section-title">一目陪你看棋</text><text class="tag">{{coach.tag}}</text></view><view class="muted">{{coach.label}}</view><view class="coach-title">{{coach.title}}</view><scroll-view scroll-y class="coach-body"><text>{{coach.text}}</text></scroll-view><view class="note">{{coach.detail}}</view><button class="plain" bindtap="openAnalysis">{{ended ? '查看计分方法' : '查看具体依据与后续应对'}} ↗</button></view>
 <view class="actions"><button class="primary" bindtap="openNew">开启新对局</button><button class="plain" bindtap="settings">对局设置</button></view><view class="note">AI 为本地搜索入门陪练。势力不等于确定地盘，复杂死活需要继续验证。</view></view>
 <view class="touch-tip" wx:if="{{previewInfo}}"><view class="row"><text class="tip-title">{{previewInfo.point}} · {{previewInfo.title}}</text></view><view>{{previewInfo.metrics}}</view><view class="tip-reason">{{previewInfo.reason}}</view><text class="muted">按住拖动换点 · 松手收起，不落子</text></view>
</view>
<view class="mask" wx:if="{{settings}}" bindtap="closeSettings"><view class="sheet" catchtap="noop"><view class="row"><text class="sheet-title">{{settings.forceNew ? '新一局，慢慢来' : '让对局适合你'}}</text><button class="close" bindtap="closeSettings">✕</button></view><view class="setting row"><text>棋盘大小</text><picker range="{{sizes}}" value="{{settings.size}}" data-field="size" bindchange="settingChange"><view class="picker">{{sizes[settings.size]}} ▾</view></picker></view><view class="setting row"><text>你执哪一方</text><picker range="{{colors}}" value="{{settings.color}}" data-field="color" bindchange="settingChange"><view class="picker">{{colors[settings.color]}} ▾</view></picker></view><view class="setting row"><text>AI 思考程度</text><picker range="{{difficulties}}" value="{{settings.difficulty}}" data-field="difficulty" bindchange="settingChange"><view class="picker">{{difficulties[settings.difficulty]}} ▾</view></picker></view><view class="note">改变棋盘或执子方会开启新对局。课程进度和累计统计会保留。</view><button class="primary" bindtap="applySettings">{{settings.forceNew ? '开始新对局' : '保存设置'}}</button></view></view>
<view class="mask" wx:if="{{detail}}" bindtap="closeDetail"><view class="sheet" catchtap="noop"><view class="row"><text class="sheet-title">{{detail.title}}</text><button class="close" bindtap="closeDetail">✕</button></view><scroll-view scroll-y class="sheet-body"><view class="paragraph" wx:for="{{detail.reasons}}" wx:key="*this">• {{item}}</view><view class="callout risk" wx:for="{{detail.risks}}" wx:key="*this">{{item}}</view><view class="section-title">接下来观察什么</view><view class="paragraph">{{detail.followUp}}</view><view class="note">{{detail.delta}}</view><view class="callout" wx:if="{{detail.response}}">{{detail.response}}<view class="note">{{detail.responseNote}}</view></view><view class="section-title" wx:if="{{detail.alternatives.length}}">也搜索过的落点</view><view class="callout" wx:for="{{detail.alternatives}}" wx:key="point"><view>{{item.point}} · {{item.title}}</view><view class="note">{{item.text}}</view></view><view class="note">推荐和占点来自本地搜索与估算，不保证最优；查看详情不会落子。</view></scroll-view><button class="primary" bindtap="closeDetail">返回棋盘，自己决定</button></view></view>
