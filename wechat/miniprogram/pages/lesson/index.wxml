<view class="page" wx:if="{{valid}}"><view class="eyebrow">YIMU GO · {{index + 1}} / {{total}}</view><view class="title">{{lesson.title}}</view><view class="paragraph">{{lesson.text}}</view><view class="callout">{{lesson.task}}</view>
 <go-board id="lesson-board" n="{{lesson.n}}" size="{{boardSize}}" board="{{board}}" last="{{last}}" captured="{{captured}}" selected="{{selected}}" dead="{{dead}}" influence="{{inf}}" bind:pick="pick" />
 <view class="answers" wx:if="{{answers.length}}"><button class="plain" wx:for="{{answers}}" wx:key="*this" data-index="{{index}}" bindtap="answer">{{item}}</button></view><button class="plain pass" wx:if="{{lesson.mode === 'passes'}}" disabled="{{done}}" bindtap="pass">{{phase === 0 ? '黑方停一手' : '白方停一手'}}</button>
 <view class="feedback {{done ? 'success' : ''}}" aria-live="polite">{{feedback}}</view><view class="actions"><button class="plain" bindtap="all">学习中心</button><button class="plain" bindtap="reset">重做本课</button></view><button class="primary next" disabled="{{!nextEnabled}}" bindtap="next">{{index === total - 1 ? '回棋盘试一试' : '下一课 →'}}</button>
</view><view class="page" wx:else><view class="paragraph">{{error}}</view><button bindtap="all">返回学习中心</button></view>
